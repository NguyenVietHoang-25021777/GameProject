--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82cf4da57ac318440a8a82d3bc1b5e82, type: 3}
  m_Name: Dialogue_ForestRanger
  m_EditorClassIdentifier: Assembly-CSharp::GameProject.Interaction.DialogueData
  speakerName: "Ng\u01B0\u1EDDi G\xE1c R\u1EEBng"
  startNodeId: forest_greeting
  nodes:
  - nodeId: forest_greeting
    speakerOverride: 
    bodyText: "Ch\xE0o m\u1EEBng t\u1EDBi R\u1EEBng T\u1ED1i... \xC1nh s\xE1ng \u1EDF \u0111\xE2y r\u1EA5t y\u1EBFu v\xE0 l\u0169 qu\xE1i b\xF3ng t\u1ED1i lu\xF4n r\xECnh r\u1EADp ph\xEDa tr\u01B0\u1EDBc."
    choices:
    - choiceText: "[\u1EA8n S\u0129 gi\u1EDBi thi\u1EC7u] T\xF4i v\u1EEBa tr\xF2 chuy\u1EC7n v\u1EDBi \u1EA8n S\u0129 ngo\xE0i s\xE2n t\u1EADp."
      nextNodeId: friendly_guide
      conditions:
      - key: hermit_trust
        comparison: 2
        value: 1
      stateEffects:
      - key: forest_guide_received
        mutationType: 2
        value: 1
    - choiceText: "[Th\xE1i \u0111\u1ED9 c\u0103ng th\u1EB3ng] T\xF4i v\u1EEBa t\u1EEB khu ph\u1EBF t\xEDch qua \u0111\xE2y..."
      nextNodeId: hostile_warning
      conditions:
      - key: hermit_trust
        comparison: 3
        value: -1
      stateEffects: []
    - choiceText: "Khu r\u1EEBng n\xE0y c\xF3 g\xEC ph\xEDa tr\u01B0\u1EDBc v\u1EADy?"
      nextNodeId: neutral_info
      conditions:
      - key: hermit_trust
        comparison: 0
        value: 0
      stateEffects: []
    - choiceText: "C\u1EA3m \u01A1n, t\xF4i s\u1EBD t\u1EF1 kh\xE1m ph\xE1."
      nextNodeId: 
      conditions: []
      stateEffects: []
  - nodeId: friendly_guide
    speakerOverride: 
    bodyText: "\u1ED2! Th\xEC ra ng\u01B0\u01A1i l\xE0 ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c \u1EA8n S\u0129 tin t\u01B0\u1EDFng! \u0110i th\u1EB3ng theo l\u1ED1i m\xF2n gi\u1EEFa hai h\xE0ng c\xE2y s\u1EBD t\u1EDBi b\xE3i \u0111\u1EA5t tr\u1ED1ng c\xF3 l\u0169 qu\xE1i tu\u1EA7n tra \u2014 h\xE3y d\xF9ng chi\xEAu th\u1EE9c m\u1EDBi c\u1EE7a ng\u01B0\u01A1i (v\xE0 nh\u1EDB nh\u1EA5n F5 \u0111\u1EC3 l\u01B0u nhanh nh\xE9!)."
    choices:
    - choiceText: "\u0110a t\u1EA1 Ng\u01B0\u1EDDi G\xE1c R\u1EEBng!"
      nextNodeId: 
      conditions: []
      stateEffects: []
  - nodeId: hostile_warning
    speakerOverride: 
    bodyText: "D\u1EEBng l\u1EA1i! Ta \u0111\xE3 nghe tin ng\u01B0\u01A1i \u0111e d\u1ECDa \u1EA8n S\u0129 ngo\xE0i ph\u1EBF t\xEDch. Ta s\u1EBD kh\xF4ng gi\xFAp \u0111\u1EE1 ng\u01B0\u01A1i \u0111\xE2u \u2014 t\u1EF1 lo l\u1EA5y th\xE2n tr\u01B0\u1EDBc l\u0169 qu\xE1i trong r\u1EEBng \u0111i!"
    choices:
    - choiceText: "H\u1EEB, t\u1EF1 ta x\u1EED l\xFD \u0111\u01B0\u1EE3c."
      nextNodeId: 
      conditions: []
      stateEffects: []
  - nodeId: neutral_info
    speakerOverride: 
    bodyText: "Ph\xEDa s\xE2u trong r\u1EEBng c\xF3 v\xE0i con qu\xE1i \u0111ang tu\u1EA7n tra. N\u1EBFu ng\u01B0\u01A1i ch\u01B0a g\u1EB7p \u1EA8n S\u0129 ngo\xE0i s\xE2n t\u1EADp, h\xE3y quay l\u1EA1i qua c\u1ED5ng t\xEDm ph\xEDa sau \u0111\u1EC3 tr\xF2 chuy\u1EC7n v\u1EDBi \xF4ng \u1EA5y tr\u01B0\u1EDBc nh\xE9!"
    choices:
    - choiceText: "C\u1EA3m \u01A1n l\u1EDDi khuy\xEAn!"
      nextNodeId: 
      conditions: []
      stateEffects: []
