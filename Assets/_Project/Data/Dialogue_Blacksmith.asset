--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82cf4da57ac318440a8a82d3bc1b5e82, type: 3}
  m_Name: Dialogue_Blacksmith
  m_EditorClassIdentifier: Assembly-CSharp::GameProject.Interaction.DialogueData
  speakerName: "Th\u1EE3 R\xE8n (Blacksmith)"
  startNodeId: greeting
  nodes:
  - nodeId: greeting
    speakerOverride: 
    bodyText: "Ch\xE0o chi\u1EBFn binh! L\xF2 r\xE8n c\u1EE7a ta \u0111ang thi\u1EBFu than \u0111\u1EC3 r\xE8n gi\xE1p cho d\xE2n l\xE0ng tr\u01B0\u1EDBc m\u1ED1i h\u1ECDa t\u1EEB R\u1EEBng S\u01B0\u01A1ng M\xF9. C\u1EADu c\xF3 th\u1EC3 ph\u1EE5 ta nh\xF3m l\xF2 m\u1ED9t tay kh\xF4ng?"
    choices:
    - choiceText: "S\u1EB5n l\xF2ng! T\xF4i s\u1EBD gi\xFAp \xF4ng nh\xF3m l\xF2 r\xE8n."
      nextNodeId: helped
      conditions:
      - key: blacksmith_helped
        comparison: 1
        value: 1
      stateEffects:
      - key: blacksmith_helped
        mutationType: 0
        value: 1
      - key: blacksmith_helped
        mutationType: 2
        value: 1
    - choiceText: "L\xF2 r\xE8n \u1ED5n c\u1EA3 ch\u1EE9? C\xF3 tin t\u1EE9c g\xEC m\u1EDBi kh\xF4ng?"
      nextNodeId: already_helped
      conditions:
      - key: blacksmith_helped
        comparison: 0
        value: 1
      stateEffects: []
    - choiceText: "\u0110\u1EC3 sau nh\xE9, t\xF4i \u0111ang v\u1ED9i l\xEAn \u0111\u01B0\u1EDDng."
      nextNodeId: 
      conditions: []
      stateEffects: []
  - nodeId: helped
    speakerOverride: 
    bodyText: "Tuy\u1EC7t v\u1EDDi! C\u1EA3m \u01A1n c\u1EADu r\u1EA5t nhi\u1EC1u (blacksmith_helped = 1). Ta \u0111\xE3 m\xE0i s\u1EAFc thanh ki\u1EBFm cho c\u1EADu \u2014 h\xE3y \u0111i qua c\u1ED5ng ph\xEDa B\u1EAFc t\u1EDBi R\u1EEBng S\u01B0\u01A1ng M\xF9 v\xE0 c\u1EA9n th\u1EADn v\u1EDBi qu\xE1i Tinh Anh!"
    choices:
    - choiceText: "C\u1EA3m \u01A1n \xF4ng, t\xF4i \u0111i ngay \u0111\xE2y."
      nextNodeId: 
      conditions: []
      stateEffects: []
  - nodeId: already_helped
    speakerOverride: 
    bodyText: "L\xF2 r\xE8n ch\xE1y r\u1EA5t \u0111\u01B0\u1EE3m nh\u1EDD c\u1EADu! Nghe \u0111\u1ED3n n\u1EBFu c\u1EE9u \u0111\u01B0\u1EE3c L\u1EEF Kh\xE1ch b\u1ECB th\u01B0\u01A1ng trong R\u1EEBng S\u01B0\u01A1ng M\xF9, c\u1EADu s\u1EBD m\u1EDF kh\xF3a \u0111\u01B0\u1EE3c b\xED m\u1EADt l\u1EDBn t\u1EA1i Di T\xEDch C\u1ED5 \u0110\u1EA1i."
    choices:
    - choiceText: "T\xF4i s\u1EBD l\u01B0u \xFD \u0111i\u1EC1u \u0111\xF3."
      nextNodeId: 
      conditions: []
      stateEffects: []
