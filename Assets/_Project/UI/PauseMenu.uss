:root {
    --pause-backdrop: rgba(6, 10, 18, 0.72);
    --pause-card-bg: rgba(14, 19, 28, 0.96);
    --pause-border: rgba(245, 196, 81, 0.62);
    --btn-bg: rgba(28, 39, 56, 0.95);
    --btn-hover: rgba(45, 65, 94, 0.98);
    --btn-primary-bg: rgba(176, 126, 28, 0.92);
    --btn-primary-hover: rgba(214, 158, 42, 0.98);
    --btn-danger-bg: rgba(102, 28, 34, 0.90);
    --btn-danger-hover: rgba(146, 38, 46, 0.96);
    --accent-gold: #F5C451;
    --accent-green: #5EE39B;
    --text-primary: #F4F7FA;
    --text-secondary: #B8C2CC;
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--pause-backdrop);
    justify-content: center;
    align-items: center;
    display: flex;
}

.pause-overlay--hidden {
    display: none;
}

.pause-card {
    width: 400px;
    max-width: 90%;
    background-color: var(--pause-card-bg);
    border-width: 2px;
    border-color: var(--pause-border);
    border-radius: 14px;
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 30px;
    padding-right: 30px;
    flex-direction: column;
    align-items: center;
}

.pause-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--accent-gold);
    margin: 0;
    margin-bottom: 6px;
    padding: 0;
}

.pause-subtitle {
    font-size: 12px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.pause-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(245, 196, 81, 0.25);
    margin-top: 16px;
    margin-bottom: 16px;
}

.pause-status {
    width: 100%;
    background-color: rgba(34, 118, 72, 0.34);
    border-width: 1px;
    border-color: rgba(94, 227, 155, 0.55);
    border-radius: 8px;
    color: var(--accent-green);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 14px;
}

.pause-status--hidden {
    display: none;
}

.pause-buttons {
    width: 100%;
    flex-direction: column;
}

.pause-btn {
    width: 100%;
    height: 44px;
    margin-bottom: 10px;
    background-color: var(--btn-bg);
    color: var(--text-primary);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 9px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pause-btn:hover {
    background-color: var(--btn-hover);
    border-color: var(--accent-gold);
}

.pause-btn--primary {
    background-color: var(--btn-primary-bg);
    border-color: var(--accent-gold);
    color: #FFFDF7;
}

.pause-btn--primary:hover {
    background-color: var(--btn-primary-hover);
    border-color: #FFE08A;
}

.pause-btn--danger {
    background-color: var(--btn-danger-bg);
    border-color: rgba(235, 96, 106, 0.45);
    margin-bottom: 0;
}

.pause-btn--danger:hover {
    background-color: var(--btn-danger-hover);
    border-color: #FF7882;
}
