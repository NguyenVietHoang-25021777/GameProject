:root {
    --menu-overlay: rgba(8, 12, 20, 0.72);
    --card-bg: rgba(14, 19, 28, 0.94);
    --card-border: rgba(245, 196, 81, 0.62);
    --btn-bg: rgba(28, 39, 56, 0.94);
    --btn-hover: rgba(45, 65, 94, 0.98);
    --btn-primary-bg: rgba(176, 126, 28, 0.92);
    --btn-primary-hover: rgba(214, 158, 42, 0.98);
    --btn-danger-bg: rgba(102, 28, 34, 0.88);
    --btn-danger-hover: rgba(146, 38, 46, 0.96);
    --accent-gold: #F5C451;
    --text-primary: #F4F7FA;
    --text-secondary: #B8C2CC;
}

.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--menu-overlay);
    justify-content: center;
    align-items: center;
    display: flex;
}

.main-menu-card {
    width: 480px;
    max-width: 90%;
    background-color: var(--card-bg);
    border-width: 2px;
    border-color: var(--card-border);
    border-radius: 16px;
    padding-top: 34px;
    padding-bottom: 28px;
    padding-left: 36px;
    padding-right: 36px;
    flex-direction: column;
    align-items: center;
}

.menu-kicker {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--accent-gold);
    margin: 0;
    margin-bottom: 6px;
    padding: 0;
}

.game-title {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    margin: 0;
    margin-bottom: 6px;
    padding: 0;
}

.game-subtitle {
    font-size: 13px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.menu-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(245, 196, 81, 0.28);
    margin-top: 20px;
    margin-bottom: 22px;
}

.menu-buttons {
    width: 100%;
    flex-direction: column;
}

.menu-btn {
    width: 100%;
    height: 48px;
    margin-bottom: 12px;
    background-color: var(--btn-bg);
    color: var(--text-primary);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.menu-btn:hover {
    background-color: var(--btn-hover);
    border-color: var(--accent-gold);
}

.menu-btn--primary {
    background-color: var(--btn-primary-bg);
    border-color: var(--accent-gold);
    color: #FFFDF7;
}

.menu-btn--primary:hover {
    background-color: var(--btn-primary-hover);
    border-color: #FFE08A;
}

.menu-btn--danger {
    background-color: var(--btn-danger-bg);
    border-color: rgba(235, 96, 106, 0.45);
}

.menu-btn--danger:hover {
    background-color: var(--btn-danger-hover);
    border-color: #FF7882;
}

.menu-btn--disabled {
    opacity: 0.38;
    background-color: rgba(24, 29, 38, 0.68);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(200, 208, 218, 0.55);
}

.save-status-label {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
}
