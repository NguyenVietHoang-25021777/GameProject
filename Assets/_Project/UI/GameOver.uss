:root {
    --go-backdrop: rgba(16, 4, 8, 0.78);
    --go-card-bg: rgba(20, 12, 16, 0.96);
    --go-border: rgba(235, 78, 86, 0.72);
    --btn-bg: rgba(34, 32, 46, 0.95);
    --btn-hover: rgba(54, 48, 72, 0.98);
    --btn-primary-bg: rgba(176, 46, 54, 0.92);
    --btn-primary-hover: rgba(214, 58, 68, 0.98);
    --accent-red: #FF6B73;
    --accent-gold: #F5C451;
    --text-primary: #F4F7FA;
    --text-secondary: #C8B8BE;
}

.gameover-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--go-backdrop);
    justify-content: center;
    align-items: center;
    display: flex;
}

.gameover-overlay--hidden {
    display: none;
}

.gameover-card {
    width: 420px;
    max-width: 90%;
    background-color: var(--go-card-bg);
    border-width: 2px;
    border-color: var(--go-border);
    border-radius: 14px;
    padding-top: 30px;
    padding-bottom: 26px;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: column;
    align-items: center;
}

.gameover-kicker {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    color: var(--accent-red);
    margin: 0;
    margin-bottom: 6px;
    padding: 0;
}

.gameover-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-primary);
    margin: 0;
    margin-bottom: 8px;
    padding: 0;
}

.gameover-subtitle {
    font-size: 13px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.gameover-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(235, 78, 86, 0.35);
    margin-top: 18px;
    margin-bottom: 20px;
}

.gameover-buttons {
    width: 100%;
    flex-direction: column;
}

.gameover-btn {
    width: 100%;
    height: 44px;
    margin-bottom: 10px;
    background-color: var(--btn-bg);
    color: var(--text-primary);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 9px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.gameover-btn:hover {
    background-color: var(--btn-hover);
    border-color: var(--accent-gold);
}

.gameover-btn--primary {
    background-color: var(--btn-primary-bg);
    border-color: var(--accent-red);
    color: #FFFDF7;
}

.gameover-btn--primary:hover {
    background-color: var(--btn-primary-hover);
    border-color: #FFA0A6;
}

.gameover-btn--danger {
    margin-bottom: 0;
}

.gameover-btn--disabled {
    opacity: 0.38;
    background-color: rgba(24, 22, 30, 0.65);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(200, 195, 205, 0.55);
}
